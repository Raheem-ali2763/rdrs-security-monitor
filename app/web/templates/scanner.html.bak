<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RDRS File Scanner</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, Arial, sans-serif;
            background:
                radial-gradient(circle at top right, #172554 0, transparent 35%),
                #070b14;
            color: #f8fafc;
        }

        .page {
            width: min(1200px, calc(100% - 40px));
            margin: 0 auto;
            padding: 30px 0 60px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
        }

        .back {
            color: #93c5fd;
            text-decoration: none;
            font-weight: 600;
        }

        .title h1 {
            margin: 0;
            font-size: 32px;
        }

        .title p {
            margin: 8px 0 0;
            color: #94a3b8;
        }

        .grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 20px;
        }

        .card {
            background: rgba(15, 23, 42, .92);
            border: 1px solid #26344f;
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,.25);
        }

        .full {
            grid-column: 1 / -1;
        }

        .card h2 {
            margin: 0 0 8px;
            font-size: 19px;
        }

        .muted {
            color: #94a3b8;
        }

        .upload {
            margin-top: 22px;
            border: 1px dashed #405276;
            border-radius: 14px;
            padding: 25px;
            background: #0a1020;
        }

        input[type="file"] {
            width: 100%;
            color: #cbd5e1;
            margin-bottom: 18px;
        }

        button {
            width: 100%;
            border: 0;
            border-radius: 11px;
            padding: 14px 18px;
            background: #2563eb;
            color: white;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        button:disabled {
            opacity: .55;
            cursor: wait;
        }

        .folders {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 18px;
        }

        .folder {
            background: #0a1020;
            border: 1px solid #253451;
            border-radius: 13px;
            padding: 17px;
        }

        .folder-title {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .folder-path {
            color: #64748b;
            font-size: 12px;
            word-break: break-all;
            margin-bottom: 10px;
        }

        .count {
            font-size: 24px;
            font-weight: 800;
        }

        .result {
            margin-top: 20px;
            background: #050914;
            border: 1px solid #1e293b;
            border-radius: 12px;
            padding: 18px;
            white-space: pre-wrap;
            overflow-x: auto;
            min-height: 90px;
            color: #cbd5e1;
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 999px;
            background: #172033;
            color: #93c5fd;
            font-size: 12px;
            font-weight: 700;
        }

        .file-list {
            margin-top: 15px;
            max-height: 300px;
            overflow-y: auto;
        }

        .file-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 11px 0;
            border-bottom: 1px solid #1e293b;
        }

        .file-name {
            word-break: break-all;
        }

        .file-size {
            color: #64748b;
            white-space: nowrap;
        }

        @media (max-width: 800px) {
            .grid,
            .folders {
                grid-template-columns: 1fr;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>
<div class="page">

    <div class="topbar">
        <div>
            <a class="back" href="/">← Back to Dashboard</a>

            <div class="title" style="margin-top:18px;">
                <h1>File Scanner</h1>
                <p>Defensive static analysis and evidence quarantine</p>
            </div>
        </div>

        <span class="status" id="folderStatus">
            Loading folders...
        </span>
    </div>

    <div class="grid">

        <section class="card">
            <h2>Scan a File</h2>

            <p class="muted">
                Upload a file for entropy analysis, SHA-256 hashing,
                ransomware-oriented indicators and threat scoring.
            </p>

            <div class="upload">
                <input id="fileInput" type="file">

                <button id="scanButton" onclick="scanFile()">
                    Scan File
                </button>
            </div>

            <div class="result" id="result">
Select a file and start a scan.
            </div>
        </section>

        <section class="card">
            <h2>Scanner Storage</h2>

            <p class="muted">
                Files are kept in dedicated scanner and evidence directories.
            </p>

            <div class="folders">

                <div class="folder">
                    <div class="folder-title">
                        Incoming
                    </div>

                    <div class="folder-path" id="incomingPath">
                        Loading...
                    </div>

                    <div class="count" id="incomingCount">
                        0
                    </div>

                    <div class="muted">
                        files
                    </div>
                </div>

                <div class="folder">
                    <div class="folder-title">
                        Quarantine
                    </div>

                    <div class="folder-path" id="quarantinePath">
                        Loading...
                    </div>

                    <div class="count" id="quarantineCount">
                        0
                    </div>

                    <div class="muted">
                        evidence files
                    </div>
                </div>

            </div>
        </section>

        <section class="card full">
            <h2>Incoming Files</h2>
            <p class="muted">
                Recently uploaded scanner files.
            </p>

            <div class="file-list" id="incomingFiles">
                Loading...
            </div>
        </section>

        <section class="card full">
            <h2>Quarantined Evidence</h2>
            <p class="muted">
                Copies of files flagged as Critical. Originals are not modified.
            </p>

            <div class="file-list" id="quarantineFiles">
                Loading...
            </div>
        </section>

    </div>
</div>

<script>
function formatBytes(bytes) {
    if (!bytes) return "0 B";

    const units = ["B", "KB", "MB", "GB"];
    const index = Math.floor(Math.log(bytes) / Math.log(1024));

    return `${(bytes / Math.pow(1024, index)).toFixed(1)} ${units[index]}`;
}


function renderFiles(elementId, files) {
    const container = document.getElementById(elementId);

    if (!files.length) {
        container.innerHTML =
            '<div class="muted">No files found.</div>';
        return;
    }

    container.innerHTML = files.map(file => `
        <div class="file-row">
            <span class="file-name">${escapeHtml(file.name)}</span>
            <span class="file-size">${formatBytes(file.size)}</span>
        </div>
    `).join("");
}


function escapeHtml(value) {
    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


async function loadFolders() {
    try {
        const response = await fetch("/api/scan/folders");
        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.detail || "Failed to load folders");
        }

        document.getElementById("incomingPath").textContent =
            data.incoming.path;

        document.getElementById("quarantinePath").textContent =
            data.quarantine.path;

        document.getElementById("incomingCount").textContent =
            data.incoming.file_count;

        document.getElementById("quarantineCount").textContent =
            data.quarantine.file_count;

        renderFiles(
            "incomingFiles",
            data.incoming.files
        );

        renderFiles(
            "quarantineFiles",
            data.quarantine.files
        );

        document.getElementById("folderStatus").textContent =
            "Storage Online";

    } catch (error) {
        document.getElementById("folderStatus").textContent =
            "Storage Error";

        console.error(error);
    }
}


async function scanFile() {
    const input = document.getElementById("fileInput");
    const button = document.getElementById("scanButton");
    const result = document.getElementById("result");

    if (!input.files.length) {
        result.textContent = "Please select a file first.";
        return;
    }

    const formData = new FormData();
    formData.append("file", input.files[0]);

    button.disabled = true;
    button.textContent = "Scanning...";
    result.textContent = "Analyzing file...";

    try {
        const response = await fetch("/api/scan", {
            method: "POST",
            body: formData
        });

        const data = await response.json();

        result.textContent =
            JSON.stringify(data, null, 2);

        await loadFolders();

    } catch (error) {
        result.textContent =
            "Scan failed: " + error;

    } finally {
        button.disabled = false;
        button.textContent = "Scan File";
    }
}


loadFolders();
setInterval(loadFolders, 5000);
</script>

</body>
</html>
